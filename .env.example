# Discord bot token (DisHost 환경변수에 실제 값을 입력하세요)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# 정확히 이 역할명을 가진 사람이 관리자 기능을 사용할 수 있습니다.
ADMIN_ROLE_NAME=관리자

# 인증 완료 역할명
VERIFY_ROLE_NAME=인증유저

# 유튜브 알림을 켠 사람에게 자동 부여할 역할명
YOUTUBE_NOTIFY_ROLE_NAME=유튜브 알림받기

# SQLite DB 파일
DB_PATH=team.db

# YouTube 새 영상 확인 주기(초)
YOUTUBE_POLL_SECONDS=120

# 루에드 유튜브 채널 ID/URL
ROUED_YOUTUBE_CHANNEL=https://youtube.com/channel/UCUPmRarC5IUyph8-tA3akUg

# 봇 표시 이름
BOT_NAME=루에드 유튜브
