# Discord bot token (DisHost 환경변수에 실제 값을 입력하세요)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# 정확히 이 역할명을 가진 사람이 관리자 기능을 사용할 수 있습니다.
ADMIN_ROLE_NAME=관리자

# 인증 완료 역할명
VERIFY_ROLE_NAME=인증유저

# SQLite DB 파일
DB_PATH=team.db

# YouTube 새 영상 확인 주기(초)
YOUTUBE_POLL_SECONDS=120

# 루에드 유튜브 채널. 정확한 채널 URL을 넣으면 됩니다.
ROUED_YOUTUBE_CHANNEL=https://www.youtube.com/@루에드

# 봇 표시 이름
BOT_NAME=루에드 유튜브
